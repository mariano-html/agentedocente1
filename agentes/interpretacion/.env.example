# Copia este archivo como .env y completa la clave.
# El modelo es configurable: "openrouter/free" enruta a un modelo gratuito disponible.
# Tambien podes fijar uno especifico, por ejemplo:
#   nvidia/nemotron-3-super-120b-a12b:free
#   google/gemma-4-31b-it:free
OPENROUTER_API_KEY=tu_api_key_aca
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
